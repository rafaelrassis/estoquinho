# Pooler: usada em runtime (app rodando, muitas conexões curtas)
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require&channel_binding=require"
# Direta (sem -pooler no host): usada só por prisma migrate/db seed
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require&channel_binding=require"
JWT_SECRET="troque-por-uma-string-aleatoria-longa"
# Criado automaticamente ao conectar um Blob Store no dashboard da Vercel (Storage -> Create -> Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
# Stripe: criar produto/preco recorrente no dashboard e pegar os IDs abaixo
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PRICE_ID="price_..."
# Criado ao configurar o endpoint do webhook (Developers -> Webhooks) apontando pra /api/billing/webhook
STRIPE_WEBHOOK_SECRET="whsec_..."
# Resend: cria conta gratis em resend.com, pega a API key. Sem dominio proprio verificado,
# so envia pro seu proprio e-mail cadastrado la (ok pra testar o fluxo)
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Estoquinho <onboarding@resend.dev>"
# Protege a rota do cron; a Vercel preenche isso e manda sozinha no header quando configurada
CRON_SECRET="gere-uma-string-aleatoria"
# Usado no link do e-mail de estoque baixo; se nao setar, usa a URL da propria requisicao
NEXT_PUBLIC_APP_URL="https://estoquinho.vercel.app"
