generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MovementType {
  ENTRADA // compra / reposição
  SAIDA   // venda
  AJUSTE  // correção manual (+ ou -)
}

enum PlanType {
  FREE
  PRO
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // estrutura para monetização futura (não implementar regra ainda)
  plan               PlanType @default(FREE)
  planProductLimit   Int      @default(30)
  stripeCustomerId   String?
  subscriptionStatus String?  // active | past_due | canceled | null

  // protecao contra forca bruta no login
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  products  Product[]
  passwordResets PasswordReset[]

  @@map("users")
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model Product {
  id          String   @id @default(cuid())
  userId      String
  name        String
  sku         String
  costCents   Int      // custo em centavos (evita float)
  priceCents  Int      // preço de venda em centavos
  photoUrl    String?
  lowStockAt  Int      @default(5) // limite configurável de estoque baixo
  stockQty    Int      @default(0) // saldo atual, desnormalizado para leitura rápida
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  movements  StockMovement[]

  @@unique([userId, sku])
  @@index([userId, active])
  @@map("products")
}

model StockMovement {
  id        String       @id @default(cuid())
  productId String
  userId    String       // desnormalizado: evita join só p/ escopar por conta
  type      MovementType
  quantity  Int          // sempre positivo; o "type" define o sinal aplicado ao stockQty
  note      String?
  createdAt DateTime     @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@map("stock_movements")
}
